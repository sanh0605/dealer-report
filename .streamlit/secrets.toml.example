# Google Sheets Connection Secrets
# Instructions:
# 1. Create a Google Cloud Project and enable Google Sheets API.
# 2. Create a Service Account and download the JSON key.
# 3. Share your target spreadsheet with the Service Account email (as Editor).
# 4. Copy the values from the JSON key into the fields below.
# 5. Rename this file to 'secrets.toml' and move it to the '.streamlit' folder.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID_HERE"
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "..."
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
